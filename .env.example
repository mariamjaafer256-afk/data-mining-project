# Copy to .env and edit. Never commit .env.
# Windows authentication (SQL Server instance used in this project: localhost\INSTANCE2022):
SQLSERVER_CONN=DRIVER={ODBC Driver 18 for SQL Server};SERVER=localhost\INSTANCE2022;DATABASE=InsiderThreat;Trusted_Connection=yes;TrustServerCertificate=yes;
# SQL login instead:
# SQLSERVER_CONN=DRIVER={ODBC Driver 18 for SQL Server};SERVER=localhost\INSTANCE2022;DATABASE=InsiderThreat;UID=your_user;PWD=your_password;TrustServerCertificate=yes;
